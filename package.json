{
  "name": "blogksolve-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm --prefix Backend start",
    "server:dev": "npm --prefix Backend run dev",
    "client": "npm --prefix frontend run dev",
    "client:build": "npm --prefix frontend run build",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
